            <column name="updated_at" valueComputed="now()"/>
        </insert>
        <insert tableName="stock_levels">
            <column name="ingredient_code" value="SUGAR"/>
            <column name="unit" value="GRAM"/>
            <column name="on_hand" valueNumeric="2000"/>
            <column name="reserved" valueNumeric="0"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
        <insert tableName="stock_levels">
            <column name="ingredient_code" value="CUP"/>
            <column name="unit" value="PIECE"/>
            <column name="on_hand" valueNumeric="500"/>
            <column name="reserved" valueNumeric="0"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
