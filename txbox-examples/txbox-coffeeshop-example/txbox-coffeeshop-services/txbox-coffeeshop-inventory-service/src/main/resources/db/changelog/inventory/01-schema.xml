            <column name="base_unit" value="MILLILITER"/>
        </insert>
        <insert tableName="ingredients">
            <column name="code" value="SUGAR"/>
            <column name="name" value="Сахар"/>
            <column name="base_unit" value="GRAM"/>
        </insert>
        <insert tableName="ingredients">
            <column name="code" value="CUP"/>
            <column name="name" value="Стакан"/>
            <column name="base_unit" value="PIECE"/>
        </insert>

        <insert tableName="stock_levels">
            <column name="ingredient_code" value="BEANS_ARABICA"/>
            <column name="unit" value="GRAM"/>
            <column name="on_hand" valueNumeric="5000"/>
            <column name="reserved" valueNumeric="0"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
        <insert tableName="stock_levels">
            <column name="ingredient_code" value="MILK"/>
            <column name="unit" value="MILLILITER"/>
            <column name="on_hand" valueNumeric="20000"/>
            <column name="reserved" valueNumeric="0"/>
            <column name="updated_at" valueComputed="now()"/>
        </insert>
