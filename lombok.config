# Lombok после перехода на Java 21 нужен ТОЛЬКО для JPA-сущностей и @Slf4j.
# Всё остальное (DTO, события, value-объекты) — records.
config.stop.bubbling = true

lombok.addLombokGeneratedAnnotation = true
lombok.nonNull.exceptionType = IllegalArgumentException

# Запрещаем то, что заменяется records / стандартной Java 21
lombok.data.flagUsage = ERROR
lombok.value.flagUsage = ERROR
lombok.val.flagUsage = ERROR
lombok.var.flagUsage = ERROR
lombok.allArgsConstructor.flagUsage = WARNING

# Логгер — только Slf4j
lombok.log.javaUtilLogging.flagUsage = ERROR
lombok.log.log4j2.flagUsage = ERROR

# Без этого @RequiredArgsConstructor теряет @Qualifier на полях
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
